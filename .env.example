# ============================================
# VARIABLES DE ENTORNO - SIGM Frontend
# ============================================

# ============================================
# DESARROLLO LOCAL
# ============================================
# URL del backend API en desarrollo local
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ============================================
# PRODUCCIÓN (Configurar en Vercel Dashboard)
# ============================================
# URL del backend API desplegado en Render
NEXT_PUBLIC_API_URL=https://sigm-api-509i.onrender.com

# IMPORTANTE: En Next.js, las variables de entorno deben usar el prefijo
# NEXT_PUBLIC_ para estar disponibles en el navegador (lado del cliente).
# NO uses REACT_APP_ ya que este es un proyecto Next.js, no Create React App.

# ============================================
# NOTAS ADICIONALES
# ============================================
# - El backend en Render (plan Free) se suspende después de 15 min de inactividad
# - La primera petición después de suspensión puede tardar ~30 segundos
# - Los tokens JWT expiran en 1 hora
# - CORS está configurado para todos los orígenes en el backend
